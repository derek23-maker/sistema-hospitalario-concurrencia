# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistema_hospitalario
# Para la demostración local, normalmente se usa el usuario root de MySQL.
# Escriba aquí la misma contraseña con la que inicia sesión en MySQL Workbench.
DB_USER=root
DB_PASSWORD=ESCRIBE_AQUI_TU_CONTRASENA_MYSQL
DB_POOL_SIZE=10
DB_POOL_RESET_SESSION=true

# FastAPI
API_TITLE=Sistema Hospitalario - API de Citas
API_CORS_ORIGINS=http://localhost,http://127.0.0.1

# Flet
HOSPITAL_API_BASE_URL=http://127.0.0.1:8000

